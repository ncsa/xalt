## Quick reference (copy/paste)

Replace `/path/to/ncsa_xalt_test_versions/00` with your real `PREFIX_DIR`.

  export PREFIX_DIR=/path/to/ncsa_xalt_test_versions/00
  export XALT_BASE_DIRECTORY=$PREFIX_DIR/target
  export XALT_LOCAL_ONLY=yes

  cd $PREFIX_DIR/xalt/ncsa_build
  module load util-linux-uuid
  export CPATH=${CPATH}:${UTIL_LINUX_UUID_HOME}/include
  ./build_xalt.sh

  ln -sf libuuid.so.1.3.0 libuuid.so \
    $PREFIX_DIR/target/xalt2/xalt/xalt/lib64/libuuid.so

  source $PREFIX_DIR/xalt/ncsa_build/load_local_xalt.sh $PREFIX_DIR
  source /path/to/venv/bin/activate
  python3 $PREFIX_DIR/../program_tests/test3.py
  find $PREFIX_DIR/log_repo -name '*.json'
